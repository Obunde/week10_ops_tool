# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- SMTP: used to email the alert when a feed breaches its SLA ---
# If SMTP_HOST / ALERT_FROM / ALERT_TO are not all set, the tool prints the
# alert to the console instead of emailing (so it always runs without creds).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_USE_TLS=true

# --- Alert addressing ---
ALERT_FROM=alerts@example.com
ALERT_TO=oncall@example.com,data-team@example.com

# --- Paths (optional; CLI flags override these) ---
DROP_FOLDER=./sample_data/inbox
FEEDS_CONFIG=./feeds.example.yaml
REPORT_DIR=./reports
